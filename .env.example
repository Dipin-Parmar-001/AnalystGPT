# Sandbox backend: "modal" for cloud execution, "local" for local execution.
SANDBOX_BACKEND=modal
# If true, a Modal failure can fall back to local execution; set false to require cloud execution.
SANDBOX_FALLBACK_TO_LOCAL=false
